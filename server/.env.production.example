# Production Environment for collabcodeio.xyz
PORT=4000
NODE_ENV=production

# URLs
CLIENT_URL=https://collabcodeio.xyz
ADMIN_URL=https://admin.collabcodeio.xyz
ALLOWED_ORIGINS=https://collabcodeio.xyz,https://www.collabcodeio.xyz,https://admin.collabcodeio.xyz

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/collabcode

# Security (Replace with long random strings)
JWT_SECRET=collabcode-prod-jwt-secret-replace-me-random-string-64char
ADMIN_JWT_SECRET=collabcode-prod-admin-secret-replace-me-random-string-64char

# Admin Login Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CreateYourSecurePasswordHere!

# Limits & Timeouts
MAX_CONNECTIONS_PER_IP=50
EXEC_TIMEOUT_MS=10000
EXEC_MAX_CONCURRENT=8
EXEC_MAX_OUTPUT=65536
