# CollabCode Server Configuration
PORT=4000
NODE_ENV=development

# Frontend & Admin URLs (used for CORS and links)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# MongoDB Connection String (fallback to in-memory if unreachable)
MONGODB_URI=mongodb://127.0.0.1:27017/collabcode

# Security & Secrets
JWT_SECRET=collabcode-change-this-jwt-secret-in-production-2024
ADMIN_JWT_SECRET=collabcode-change-this-admin-secret-in-production-2024

# Default Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=collabcode-admin

# Limits & Timeouts
MAX_CONNECTIONS_PER_IP=50
EXEC_TIMEOUT_MS=10000
EXEC_MAX_CONCURRENT=8
EXEC_MAX_OUTPUT=65536
